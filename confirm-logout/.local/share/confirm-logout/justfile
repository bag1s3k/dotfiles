@default:
    just --list

package_name := "confirm-logout"
main_script := "src/confirm_logout/__init__.py"

run file=package_name:
    uv run {{file}}

dev file=main_script:
    uv run textual run --dev {{file}}


# Textual commands
console:
    uv run textual console

colors:
    uv run textual run -c textual colors


# Ruff commands
ruff:
    just check
    just format

check +args=".":
    uv run ruff check {{args}}

format +args=".":
    uv run ruff format {{args}}

build:
    uv run pyinstaller \
        --onefile \
        --name {{package_name}} \
        --add-data "src/confirm_logout/style.tcss:confirm_logout" \
        src/confirm_logout/__main__.py
