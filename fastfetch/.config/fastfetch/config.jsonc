{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "modules": [
        // "title",
        {
            "type": "title",
            "format": "{user-name}"
        },
        "separator",
        {
            "type": "os",
            "format": "{id} {version-id}"
        },
        // "host",
        // "kernel",
        {
            "type": "uptime",
            "format": "{days}d {hours}h {minutes}m"
        },
        // "packages",
        // "shell",
        // "display",
        // "de",
        // "wm",
        // "wmtheme",
        // "theme",
        // "icons",
        // "font",
        // "cursor",
        {
            "type": "terminal",
            "format": "{pretty-name}"
        },
        // "terminalfont",
        // "gpu",
        "memory",
        // "swap",
        {
            "type": "disk",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        // "localip",
        // "battery",
        // "poweradapter",
        // "locale",
        // "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ],
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": {
            "1": "#CDD6F4",
            "2": "#F9E2AF",
            "3": "#FAB387",
            "4": "#585B70"
        },
        "padding": {
            "top": 0,
            "left": 1,
            "right": 3
        }
    }
}
